# Store actual values only on the VPS: /etc/maker3d/runtime.env (chmod 600).
# Get the Session pooler host from Supabase > Emersoft > Connect.
# Use the dedicated maker3d_app database role, never the shared postgres account.
DATABASE_URL=postgresql://maker3d_app.hzsuckglbihyraaotzba:CHANGE_ME@SESSION_POOLER_HOST:5432/postgres
DATABASE_MODE=postgres
# Optional path to Supabase database CA certificate, mounted in the container.
# DATABASE_CA_FILE=/run/secrets/supabase-ca.crt
SUPABASE_URL=https://hzsuckglbihyraaotzba.supabase.co
SUPABASE_SECRET_KEY=CHANGE_ME_SERVER_SECRET_KEY
SUPABASE_STORAGE_BUCKET=maker3d-projects
FILE_STORAGE=supabase
PUBLIC_ORIGIN=https://maker3d.emersol.ai
COOKIE_SECURE=1
TRUST_PROXY=1
NODE_ENV=production
